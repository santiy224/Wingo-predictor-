  <div id="winPopup" class="result-popup win-popup">
    <h3>🎉 WINNER! 🎉</h3>
    <p>Your prediction was correct!</p>
    <p id="winDetails">BIG (7)</p>
    <p>Current Streak: <span id="winStreak">1</span></p>
    <button class="close-popup" onclick="closeResultPopup()">CLOSE</button>
  </div>

  <div id="lossPopup" class="result-popup loss-popup">
    <h3>😢 TRY AGAIN! 😢</h3>
    <p>Your prediction was incorrect</p>
    <p id="lossDetails">Actual: SMALL (2)</p>
    <p>Better luck next time!</p>
    <button class="close-popup" onclick="closeResultPopup()">CLOSE</button>
  </div>

  <audio id="winSound" src="https://assets.mixkit.co/sfx/preview/mixkit-winning-chimes-2015.mp3" preload="auto"></audio>
  <audio id="lossSound" src="https://assets.mixkit.co/sfx/preview/mixkit-retro-arcade-lose-2027.mp3" preload="auto"></audio>

  <script>
    // Game state
    let lastPeriod = "";
    let resultHistory = [];
    const maxHistory = 100;
    let streakCount = 0;
    let winCount = 0;
    let lossCount = 0;
    let currentMode = 'normal';
    let accuracy = 85;
    let lastWasWin = false;

    // Initialize sounds
    const winSound = document.getElementById('winSound');
    const lossSound = document.getElementById('lossSound');

    // Initialize prediction algorithms
    const algorithms = {
      normal: {
        name: "Normal Mode",
        accuracy: 75,
        description: "Standard prediction algorithm with 75% accuracy",
        predict: function(digits, period) {
          const sum = digits.reduce((a, b) => a + b, 0);
          const product = digits.reduce((a, b) => a * b, 1);
          const timeSeed = new Date().getSeconds();
          const rawScore = (sum * 1.2) + (product * 0.5) + (timeSeed * 0.3);
          const number = Math.floor(rawScore % 10);
          return number < 5 ? "SMALL" : "BIG";
        }
      },
      pro: {
        name: "Pro Mode",
        accuracy: 85,
        description: "Advanced algorithm with 85% accuracy using pattern recognition",
        predict: function(digits, period) {
          const sum = digits.reduce((a, b) => a + b, 0);
          const product = digits.reduce((a, b) => a * b, 1);
          const variance = getVariance(digits);
          const evenCount = digits.filter(d => d % 2 === 0).length;
          const oddCount = digits.length - evenCount;
          const ratio = sum / (product || 1);
          const timeSeed = new Date().getSeconds();
          
          const rawScore = (sum * 1.5) + (product * 0.8) + (variance * 2) + 
                          (ratio * 1.2) + (timeSeed * 0.5) + (streakCount * 0.3);
          const number = Math.floor(rawScore % 10);
          
          if (lastWasWin && streakCount > 2) {
            const bias = streakCount % 2 === 0 ? 1 : -1;
            const biasedNumber = Math.max(0, Math.min(9, number + bias));
            return biasedNumber < 5 ? "SMALL" : "BIG";
          }
          
          return number < 5 ? "SMALL" : "BIG";
        }
      },
      expert: {
        name: "Expert Mode",
        accuracy: 92,
        description: "Expert algorithm with 92% accuracy using machine learning patterns",
        predict: function(digits, period) {
          const lastThree = resultHistory.slice(0, 3);
          const lastResults = lastThree.map(r => r.result);
          const lastNumbers = lastThree.map(r => r.number);
          
          const sum = digits.reduce((a, b) => a + b, 0);
          const product = digits.reduce((a, b) => a * b, 1);
          const variance = getVariance(digits);
          const evenCount = digits.filter(d => d % 2 === 0).length;
          const oddCount = digits.length - evenCount;
          const ratio = sum / (product || 1);
          const timeSeed = new Date().getSeconds();
          const periodSeed = parseInt(period.slice(-4)) % 100;
          
          const repeatingPatternWeight = lastResults[0] === lastResults[1] ? 1.5 : 1;
          const alternatingPatternWeight = lastResults[0] !== lastResults[1] ? 1.3 : 1;
          const numberTrendWeight = lastNumbers[0] < lastNumbers[1] ? 1.2 : 0.8;
          
          const rawScore = (sum * 1.8) + (product * 1.2) + (variance * 2.5) + 
                          (ratio * 1.5) + (timeSeed * 0.7) + (streakCount * 0.5) +
                          (periodSeed * 0.3) + (repeatingPatternWeight * 1.2) +
                          (alternatingPatternWeight * 1.1) + (numberTrendWeight * 0.9);
          
          const number = Math.floor(rawScore % 10);
          
          if (lastThree.length >= 2) {
            if (lastResults[0] === lastResults[1] && lastResults[0] === lastResults[2]) {
              return lastResults[0] === "BIG" ? "SMALL" : "BIG";
            }
            
            if (lastNumbers[0] > 7 && lastNumbers[1] > 7) {
              return "SMALL";
            }
            
            if (lastNumbers[0] < 3 && lastNumbers[1] < 3) {
              return "BIG";
            }
          }
          
          const expertBias = (periodSeed % 5) - 2;
          const finalNumber = Math.max(0, Math.min(9, number + expertBias));
          return finalNumber < 5 ? "SMALL" : "BIG";
        }
      }
    };

    function setMode(mode) {
      currentMode = mode;
      accuracy = algorithms[mode].accuracy;
      
      document.getElementById('normalMode').classList.remove('active');
      document.getElementById('proMode').classList.remove('active');
      document.getElementById('expertMode').classList.remove('active');
      document.getElementById(mode + 'Mode').classList.add('active');
      
      document.getElementById('accuracy').innerHTML = `${accuracy}% <div class="accuracy-meter"><div class="accuracy-bar" style="width:${accuracy}%"></div></div>`;
    }

    function updatePeriodAndTimer() {
      let now = new Date();
      let startTime = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 5, 30, 0);
      let elapsedSeconds = Math.floor((now - startTime) / 1000);

      if (elapsedSeconds < 0) {
        startTime.setDate(startTime.getDate() - 1);
        elapsedSeconds = Math.floor((now - startTime) / 1000);
      }

      let totalPeriods = Math.floor(elapsedSeconds / 30);
      let upcomingPeriod = totalPeriods + 1;

      let formattedDate = new Intl.DateTimeFormat('en-GB', {
        year: 'numeric', month: '2-digit', day: '2-digit'
      }).format(now).replace(/\//g, '');

      let periodNumber = `100005${String(upcomingPeriod).padStart(4, '0')}`;
      let lastFourDigits = periodNumber.slice(-4);
      let fullPeriod = formattedDate + periodNumber;

      if (periodNumber !== lastPeriod) {
        lastPeriod = periodNumber;
        generateResult(lastFourDigits, fullPeriod);
        generateFuturePredictions();
      }

      document.getElementById("period").innerText = fullPeriod;
      let remainingSeconds = 30 - (elapsedSeconds % 30);
      document.getElementById("timer").innerText = `00:${String(remainingSeconds).padStart(2, '0')}`;

      setTimeout(updatePeriodAndTimer, 1000);
    }

    function generateResult(lastFourDigits, fullPeriod) {
      const resultElement = document.getElementById("result");
      resultElement.innerHTML = 'ANALYZING...';
      
      const algorithm = algorithms[currentMode];
      
      setTimeout(() => {
        const digits = lastFourDigits.split('').map(Number);
        const prediction = algorithm.predict(digits, fullPeriod);
        const number = Math.floor(Math.random() * 10);
        const isWin = Math.random() * 100 < algorithm.accuracy;
        const actualResult = isWin ? prediction : (prediction === "BIG" ? "SMALL" : "BIG");
        
        resultElement.innerHTML = prediction;
        resultElement.className = prediction.toLowerCase();
        
        document.getElementById("number").innerText = number;

        if (isWin) {
          streakCount++;
          lastWasWin = true;
          winCount++;
          winSound.play();
          showResultPopup(true, prediction, number);
        } else {
          streakCount = 0;
          lastWasWin = false;
          lossCount++;
          lossSound.play();
          showResultPopup(false, prediction, number);
        }

        document.getElementById('winCount').textContent = winCount;
        document.getElementById('lossCount').textContent = lossCount;
        document.getElementById('streakCount').textContent = streakCount;

        resultHistory.unshift({ 
          period: fullPeriod, 
          prediction,
          actual: actualResult,
          number,
          win: isWin,
          mode: currentMode
        });
        
        if (resultHistory.length > maxHistory) resultHistory.pop();
        updateHistoryDisplay();
      }, 1500);
    }

    function showResultPopup(isWin, prediction, actualNumber) {
      const popup = isWin ? document.getElementById('winPopup') : document.getElementById('lossPopup');
      
      if (isWin) {
        document.getElementById('winDetails').textContent = `${prediction} (${actualNumber})`;
        document.getElementById('winStreak').textContent = streakCount;
      } else {
        const actualResult = prediction === "BIG" ? "SMALL" : "BIG";
        document.getElementById('lossDetails').textContent = `Actual: ${actualResult} (${actualNumber})`;
      }
      
      popup.style.display = 'block';
      
      setTimeout(() => {
        if (popup.style.display === 'block') {
          popup.style.display = 'none';
        }
      }, 5000);
    }

    function closeResultPopup() {
      document.getElementById('winPopup').style.display = 'none';
      document.getElementById('lossPopup').style.display = 'none';
    }

    function generateFuturePredictions() {
      const algorithm = algorithms[currentMode];
      const now = new Date();
      const timeSeed = now.getSeconds() + now.getMilliseconds();
      
      const pred1Digits = String(Math.floor(timeSeed * 1.3 % 10000)).padStart(4, '0').split('').map(Number);
      const pred1 = algorithm.predict(pred1Digits, "next");
      const pred1Num = Math.floor(timeSeed * 1.3 % 10);
      document.getElementById("nextPred1").textContent = `${pred1} (${pred1Num})`;
      
      const pred2Digits = String(Math.floor(timeSeed * 1.7 % 10000)).padStart(4, '0').split('').map(Number);
      const pred2 = algorithm.predict(pred2Digits, "next+1");
      const pred2Num = Math.floor(timeSeed * 1.7 % 10);
      document.getElementById("nextPred2").textContent = `${pred2} (${pred2Num})`;
      
      const pred3Digits = String(Math.floor(timeSeed * 2.1 % 10000)).padStart(4, '0').split('').map(Number);
      const pred3 = algorithm.predict(pred3Digits, "next+2");
      const pred3Num = Math.floor(timeSeed * 2.1 % 10);
      document.getElementById("nextPred3").textContent = `${pred3} (${pred3Num})`;
    }

    function getVariance(arr) {
      const mean = arr.reduce((a, b) => a + b, 0) / arr.length;
      return arr.reduce((sum, val) => sum + (val - mean) ** 2, 0) / arr.length;
    }

    function updateHistoryDisplay() {
      const historyEl = document.getElementById("history");
      historyEl.innerHTML = '';
      resultHistory.forEach((item, index) => {
        const div = document.createElement("div");
        div.className = "history-item";
        
        const resultIcon = item.win ? 
          '<i class="fas fa-check-circle" style="color: #4caf50; margin-right: 4px;"></i>' : 
          '<i class="fas fa-times-circle" style="color: #f44336; margin-right: 4px;"></i>';
        
        const modeBadge = `<span style="font-size:9px; background:#333; padding:1px 3px; border-radius:2px;">${item.mode.toUpperCase()}</span>`;
        
        div.innerHTML = `
          <div class="history-content">
            <p><strong> PERIOD :</strong> ${item.period} ${modeBadge}</p>
            <p><strong> PREDICTION :</strong> ${resultIcon}<span class="${item.prediction.toLowerCase()}">${item.prediction}</span> (${item.number})</p>
            <p><strong> RESULT :</strong> <span class="${item.win ? 'big' : 'small'}">${item.win ? 'WIN' : 'LOSS'}</span></p>
          </div>
          <i class="fas fa-trash delete-icon" title="Delete" onclick="deleteHistoryItem(${index})"></i>
        `;
        historyEl.appendChild(div);
      });
    }

    function deleteHistoryItem(index) {
      const item = resultHistory[index];
      if (item.win) winCount--;
      else lossCount--;
      
      if (index === 0 && item.win) {
        streakCount--;
      }
      
      resultHistory.splice(index, 1);
      updateHistoryDisplay();
      
      document.getElementById('winCount').textContent = winCount;
      document.getElementById('lossCount').textContent = lossCount;
      document.getElementById('streakCount').textContent = streakCount;
    }

    function clearHistory() {
      document.getElementById("popupOverlay").style.display = "flex";
    }

    function closePopup() {
      document.getElementById("popupOverlay").style.display = "none";
    }

    function confirmClear() {
      resultHistory = [];
      winCount = 0;
      lossCount = 0;
      streakCount = 0;
      updateHistoryDisplay();
      
      document.getElementById('winCount').textContent = winCount;
      document.getElementById('lossCount').textContent = lossCount;
      document.getElementById('streakCount').textContent = streakCount;
      
      closePopup();
    }

    document.getElementById("exportBtn").addEventListener("click", () => {
      if (resultHistory.length === 0) {
        alert("No history to export yet!");
        return;
      }
      
      const csvRows = [
        ["Period", "Prediction", "Number", "Result", "Mode"],
        ...resultHistory.map(r => [r.period, r.prediction, r.number, r.win ? "WIN" : "LOSS", r.mode.toUpperCase()])
      ];
      const csvContent = csvRows.map(e => e.join(",")).join("\n");
      const blob = new Blob([csvContent], { type: "text/csv" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `aditya_prediction_history_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
    });

    document.getElementById("shareBtn").addEventListener("click", () => {
      if (!resultHistory.length) {
        alert("No prediction to share yet!");
        return;
      }

      const latest = resultHistory[0];
      const periodShort = latest.period.slice(-4);
      const resultIcon = latest.win ? '✅' : '❌';
      const message = `
🔥 *TDMODX LIVE RESULT FIXER (${currentMode.toUpperCase()})* 🔥
*━━━━━━━━━━━━━━*
🕒 *Period*: ${periodShort}
🎯 *Prediction*: ${latest.prediction} (${latest.number}) ${resultIcon}
💎 *Accuracy*: ${accuracy}% WIN RATE
📊 *Stats*: ${winCount}W ${lossCount}L (Streak: ${streakCount})
*━━━━━━━━━━━━━━*
💸 *Next Prediction*: ${document.getElementById("nextPred1").textContent}
🚀 *2nd Prediction*: ${document.getElementById("nextPred2").textContent}
✨ *3rd Prediction*: ${document.getElementById("nextPred3").textContent}
*━━━━━━━━━━━━━━*
🔮 *Try Now*: [Aditya Bhaiya Predictor]
      `.trim();

      if (navigator.share) {
        navigator.share({
          title: `Aditya Bhaiya Prediction (${currentMode.toUpperCase()})`,
          text: message.replace(/\*/g, ''),
          url: window.location.href
        }).catch(() => {
          copyToClipboard(message);
        });
      } else {
        copyToClipboard(message);
      }
    });

    function copyToClipboard(text) {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      alert('Prediction copied to clipboard! Paste it in Telegram or WhatsApp.');
    }

    function goBack() {
      window.history.back();
    }

    document.addEventListener('DOMContentLoaded', () => {
      setMode('normal');
      setTimeout(() => {
        updatePeriodAndTimer();
      }, 500);
    });
  </script>
</body>
</html>
